# Contract only. Copy to an ignored secret-manager/deployment source and replace all values.
NODE_ENV=production
CONFIG_FROM_ENV=true
API_PORT=4000
WEB_URL=https://marketplace.example.com
API_URL=http://api.internal:4000
WEB_PORT=3000
NEXT_PUBLIC_MAP_STYLE_URL=https://maps.example.com/styles/marketplace.json
NEXT_PUBLIC_MAP_ATTRIBUTION=Map data provider attribution
DATABASE_HOST=postgres.internal
DATABASE_PORT=5432
DATABASE_NAME=marketplace
DATABASE_USER=marketplace_runtime
DATABASE_PASSWORD=replace-with-secret-manager-value
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-32-character-secret-manager-value
REDIS_TLS=true
S3_REGION=eu-west-1
S3_BUCKET=marketplace-media
S3_ACCESS_KEY=replace-with-runtime-principal
S3_SECRET_KEY=replace-with-secret-manager-value-at-least-32-chars
S3_FORCE_PATH_STYLE=false
MEDIA_MAX_FILE_SIZE=15728640
MEDIA_MAX_IMAGES_PER_LISTING=25
MEDIA_UPLOAD_URL_TTL=600
MEDIA_READ_URL_TTL=600
MEDIA_MAX_WIDTH=12000
MEDIA_MAX_HEIGHT=12000
MEDIA_MAX_PIXELS=40000000
MEDIA_THUMBNAIL_WIDTH=320
MEDIA_MEDIUM_WIDTH=960
MEDIA_LARGE_WIDTH=1600
MEDIA_OUTPUT_QUALITY=82
MEDIA_WORKER_CONCURRENCY=2
LOG_LEVEL=info
METRICS_ENABLED=true
SHUTDOWN_TIMEOUT_MS=20000
SLOW_REQUEST_MS=2000
SLOW_JOB_MS=10000
TRUST_PROXY_HOPS=1
AUTH_TOKEN_RETENTION_DAYS=30
OUTBOX_PROCESSED_RETENTION_DAYS=60
DELIVERY_SENT_RETENTION_DAYS=60
CLEANUP_BATCH_SIZE=500
CLEANUP_MAX_ROWS_PER_RUN=5000
SAVED_SEARCH_MAX_PER_USER=50
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=120
OUTBOX_MAX_ATTEMPTS=8
MESSAGING_MAX_BODY_CODE_POINTS=8000
REALTIME_REVALIDATE_SECONDS=60
SWAGGER_ENABLED=false
AUTH_ACCESS_TOKEN_SECRET=replace-with-64-lowercase-hex-secret
AUTH_ACCESS_KEY_ID=release-key-id
AUTH_ACCESS_TOKEN_TTL=600
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_REFRESH_IDLE_TTL=604800
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=strict
AUTH_VERIFICATION_TOKEN_TTL=86400
AUTH_PASSWORD_RESET_TOKEN_TTL=1800
AUTH_EMAIL_MODE=http
EMAIL_PROVIDER=http
EMAIL_DELIVERY_URL=https://email-gateway.example.com/send
EMAIL_DELIVERY_KEY=replace-with-provider-secret-at-least-16-chars
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Automotive Marketplace
EMAIL_DELIVERY_BATCH_SIZE=50
EMAIL_DELIVERY_MAX_ATTEMPTS=8
EMAIL_DELIVERY_LEASE_SECONDS=120
EMAIL_DELIVERY_CONCURRENCY=8
EMAIL_DELIVERY_TIMEOUT_MS=5000
