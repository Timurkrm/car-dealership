{
  "name": "@marketplace/api",
  "version": "0.1.0-rc.1",
  "private": true,
  "scripts": {
    "dev": "npm run build && concurrently --kill-others --raw \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "worker:media": "node dist/main-media-worker.js",
    "worker:engagement": "node dist/main-engagement-worker.js",
    "worker:delivery": "node dist/main-delivery-worker.js",
    "delivery:retry": "node dist/delivery-retry-command.js",
    "outbox:recover": "node dist/outbox-recover-command.js",
    "media:cleanup": "node dist/media-cleanup-command.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/unit/*.test.js .test-build/test/http/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node ../../scripts/run-integration-tests.mjs",
    "search:plans": "tsc -p tsconfig.test.json && node .test-build/test/performance/search-plans.js",
    "moderation:plans": "tsc -p tsconfig.test.json && node .test-build/test/performance/moderation-plans.js",
    "engagement:plans": "tsc -p tsconfig.test.json && node .test-build/test/performance/engagement-plans.js",
    "messaging:plans": "tsc -p tsconfig.test.json && node .test-build/test/performance/messaging-plans.js",
    "account-delivery:plans": "tsc -p tsconfig.test.json && node .test-build/test/performance/account-delivery-plans.js",
    "ops:status": "npm run build && node dist/operations/ops-status-command.js",
    "ops:verify-data": "npm run build && node dist/operations/ops-verify-data-command.js",
    "ops:storage-probe": "npm run build && node dist/operations/ops-storage-probe-command.js",
    "maintenance:cleanup": "npm run build && node dist/operations/maintenance-cleanup-command.js",
    "bootstrap:admin": "npm run build && node dist/operations/admin-bootstrap-command.js",
    "test:resilience": "tsc -p tsconfig.test.json && node --test .test-build/test/integration/resilience.test.js",
    "migration:create": "node ../../scripts/migration.mjs create",
    "migration:generate": "node ../../scripts/migration.mjs generate",
    "migration:run": "node ../../scripts/migration.mjs run",
    "migration:revert": "node ../../scripts/migration.mjs revert"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1134.0",
    "@aws-sdk/s3-request-presigner": "3.1135.0",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.5",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "redis": "5.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "socket.io": "4.8.1",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.5",
    "@types/express": "5.0.6"
  }
}
