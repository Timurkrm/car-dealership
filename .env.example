# Placeholders only. npm run env:init creates private local credentials.
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Public, build-time MapLibre style. Production CSP must allow its style/tile/font origins.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
# Optional provider attribution appended to attribution embedded in the style sources.
NEXT_PUBLIC_MAP_ATTRIBUTION=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=marketplace
DATABASE_USER=marketplace
DATABASE_PASSWORD=replace-with-generated-local-password
DATABASE_SSL=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-generated-local-password
REDIS_TLS=false
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=vehicle-media
S3_ACCESS_KEY=replace-with-generated-local-key
S3_SECRET_KEY=replace-with-generated-local-secret
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001
MEDIA_MAX_FILE_SIZE=15728640
MEDIA_MAX_IMAGES_PER_LISTING=25
MEDIA_UPLOAD_URL_TTL=600
MEDIA_READ_URL_TTL=600
MEDIA_MAX_WIDTH=12000
MEDIA_MAX_HEIGHT=12000
MEDIA_MAX_PIXELS=40000000
MEDIA_THUMBNAIL_WIDTH=320
MEDIA_MEDIUM_WIDTH=960
MEDIA_LARGE_WIDTH=1600
# Output is always WebP; no configurable unsafe formats.
MEDIA_OUTPUT_QUALITY=82
MEDIA_WORKER_CONCURRENCY=2
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=20000
SLOW_REQUEST_MS=2000
SLOW_JOB_MS=10000
# Exact number of trusted reverse-proxy hops; keep 0 for direct/local traffic.
TRUST_PROXY_HOPS=0
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
AUTH_TOKEN_RETENTION_DAYS=30
OUTBOX_PROCESSED_RETENTION_DAYS=60
DELIVERY_SENT_RETENTION_DAYS=60
CLEANUP_BATCH_SIZE=500
CLEANUP_MAX_ROWS_PER_RUN=5000
SAVED_SEARCH_MAX_PER_USER=50
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=120
OUTBOX_MAX_ATTEMPTS=8
MESSAGING_MAX_BODY_CODE_POINTS=8000
REALTIME_REVALIDATE_SECONDS=60
SWAGGER_ENABLED=true
AUTH_ACCESS_TOKEN_SECRET=replace-with-generated-auth-signing-key
AUTH_ACCESS_KEY_ID=current
# Planned rotation: paired previous secret/key ID, distinct from current key ID.
# AUTH_PREVIOUS_ACCESS_TOKEN_SECRET=replace-with-previous-private-signing-key
# AUTH_PREVIOUS_ACCESS_KEY_ID=previous
AUTH_ACCESS_TOKEN_TTL=600
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_REFRESH_IDLE_TTL=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=strict
AUTH_VERIFICATION_TOKEN_TTL=86400
AUTH_PASSWORD_RESET_TOKEN_TTL=1800
AUTH_EMAIL_MODE=preview
# Production uses EMAIL_PROVIDER=http. AUTH_EMAIL_* remains a compatibility alias.
EMAIL_PROVIDER=preview
# EMAIL_DELIVERY_URL=https://your-email-gateway.example/send
# EMAIL_DELIVERY_KEY=replace-with-private-email-delivery-key
EMAIL_FROM_ADDRESS=no-reply@marketplace.example.test
EMAIL_FROM_NAME=Vehicle Marketplace
EMAIL_DELIVERY_BATCH_SIZE=50
EMAIL_DELIVERY_MAX_ATTEMPTS=8
EMAIL_DELIVERY_LEASE_SECONDS=120
EMAIL_DELIVERY_CONCURRENCY=8
EMAIL_DELIVERY_TIMEOUT_MS=5000
